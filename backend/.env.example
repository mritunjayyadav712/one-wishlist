# ─────────────────────────────────────────────────────────────────────────────
# OneWishlist Backend — Environment Variables
# Copy this file to .env and fill in real values before running locally.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=development
PROJECT_NAME="OneWishlist API"

# ── Database ──────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (add ?sslmode=require for production)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/onewishlist
#DATABASE_URL=postgresql://neondb_owner:npg_u6VdniF4QswN@ep-plain-waterfall-az6t32wk.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://username:your_password_here@host/database?sslmode=require
POSTMARK_API_TOKEN=your_postmark_api_token
JWT_SECRET=your_random_secret
# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_random_64_char_hex_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Cookies ───────────────────────────────────────────────────────────────────
COOKIE_SECURE=false         # Set to true in production (requires HTTPS)
COOKIE_SAMESITE=lax         # lax | strict | none
# COOKIE_DOMAIN=             # Leave blank for localhost; set to .yourdomain.com in prod

# ── Postmark Transactional Email ──────────────────────────────────────────────
# Get your token from https://account.postmarkapp.com/servers
# Set to "sandbox" during development to only log emails (no real delivery)
POSTMARK_API_TOKEN=sandbox
FROM_EMAIL=noreply@onewishlist.com
FROM_EMAIL_NAME=OneWishlist

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
