# ─────────────────────────────────────────────────────────────────────────────
# OneWishlist Backend — Environment Variables
# Copy this file to .env and fill in real values before running locally.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=development
PROJECT_NAME="OneWishlist API"

# ── Database ──────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string (add ?sslmode=require for production)
DATABASE_URL=postgresql://username:your_password_here@host/database?sslmode=require

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_random_64_char_hex_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Cookies ───────────────────────────────────────────────────────────────────
COOKIE_SECURE=false         # Set to true in production (requires HTTPS)
COOKIE_SAMESITE=lax         # lax | strict | none
# COOKIE_DOMAIN=             # Leave blank for localhost; set to .yourdomain.com in prod

# ── Resend Transactional Email ────────────────────────────────────────────────
# Get your API key from https://resend.com/api-keys
# Leave as "sandbox" during development to only log emails (no real delivery)
RESEND_API_KEY=re_xxxxxxxxx        # 👈 Replace with your real Resend API key
FROM_EMAIL=onboarding@resend.dev   # Must be a verified sender in your Resend account
FROM_EMAIL_NAME=OneWishlist

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
